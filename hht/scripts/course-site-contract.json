  "checks": [
    {
      "label": "one footer",
      "pages": [
        "index.html",
        "menu.html",
        "about.html"
      ],
      "match": {
        "tag": "footer",
        "cls": "site-footer"
      },
      "count": 1
    },
    {
      "label": "starting footer year",
      "pages": [
        "index.html",
        "menu.html",
        "about.html"
      ],
      "match": {
        "tag": "small",
        "text": "2024 NORTH LIGHT COFFEE"
      },
      "count": 1
    },
    {
      "label": "starting founding text",
      "pages": [
        "index.html",
        "about.html"
      ],
      "match": {
        "tag": "p",
        "text": "創業10年"
      },
      "count": 1
    },
    {
      "label": "menu target",
      "pages": [
        "menu.html"
      ],
      "match": {
        "cls": "menu-grid",
        "attrs": {
          "id": "menu-list"
        }
      },
      "count": 1
    },
    {
      "label": "dummy home paragraph",
      "pages": [
        "index.html"
      ],
      "match": {
        "tag": "p",
        "text": "ここに文章が入ります。"
      },
      "count": 1
    },
    {
      "label": "dummy about paragraph",
      "pages": [
        "about.html"
      ],
      "match": {
        "tag": "p",
        "text": "ダミーテキストです。"
      },
      "count": 1
    }
  ],
  "sites": [
    {
      "directory": "starter-site"
    },
    {
